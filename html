<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>WiMusica — Feel The Music</title>

    <!-- CSS -->
    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- BACKGROUND -->
    <div class="background-glow glow-purple"></div>
    <div class="background-glow glow-blue"></div>


    <!-- =========================
         NAVBAR
    ========================== -->

    <header class="navbar">

        <a href="#" class="logo">

            <div class="logo-icon">
                W
            </div>

            <div class="logo-text">
                Wi<span>Musica</span>
            </div>

        </a>


        <nav class="nav-menu">

            <a href="#home">Home</a>
            <a href="#discover">Discover</a>
            <a href="#genres">Genres</a>
            <a href="#artists">Artists</a>

        </nav>


        <div class="nav-right">

            <button class="search-button">
                🔍
            </button>

            <button class="login-button">
                Login
            </button>

            <button class="menu-button" id="menuButton">
                ☰
            </button>

        </div>

    </header>



    <!-- =========================
         HERO
    ========================== -->

    <main>

        <section class="hero" id="home">


            <!-- LEFT -->

            <div class="hero-content">

                <div class="hero-label">

                    <span></span>

                    THE WORLD OF MUSIC

                </div>


                <h1>

                    Music that
                    <br>

                    <strong>
                        feels like you.
                    </strong>

                </h1>


                <p>

                    Discover new artists, explore different
                    genres, and find songs that become part
                    of your story.

                </p>


                <div class="hero-buttons">

                    <a href="#discover" class="button-primary">

                        Start Listening

                        <span>→</span>

                    </a>


                    <a href="#genres" class="button-secondary">

                        Explore Music

                    </a>

                </div>


                <!-- STATS -->

                <div class="stats">

                    <div>

                        <strong>
                            50K+
                        </strong>

                        <span>
                            Songs
                        </span>

                    </div>


                    <div class="divider"></div>


                    <div>

                        <strong>
                            8K+
                        </strong>

                        <span>
                            Artists
                        </span>

                    </div>


                    <div class="divider"></div>


                    <div>

                        <strong>
                            120+
                        </strong>

                        <span>
                            Genres
                        </span>

                    </div>

                </div>

            </div>



            <!-- RIGHT MUSIC VISUAL -->

            <div class="hero-art">

                <div class="big-glow"></div>


                <!-- ALBUM -->

                <div class="album">

                    <div class="album-sun"></div>

                    <div class="mountain mountain-one"></div>

                    <div class="mountain mountain-two"></div>

                    <div class="album-title">
                        W
                    </div>

                </div>


                <!-- VINYL -->

                <div class="vinyl">

                    <div class="vinyl-center"></div>

                </div>


                <!-- NOW PLAYING -->

                <div class="now-playing">

                    <div class="song-image"></div>

                    <div class="song-info">

                        <small>
                            NOW PLAYING
                        </small>

                        <strong>
                            Midnight Dreams
                        </strong>

                        <span>
                            WiMusica Originals
                        </span>

                    </div>

                    <button id="playButton">
                        ▶
                    </button>

                </div>


                <div class="floating-note note-one">
                    ♪
                </div>

                <div class="floating-note note-two">
                    ♫
                </div>

            </div>

        </section>



        <!-- =========================
             DISCOVER
        ========================== -->

        <section class="discover section" id="discover">

            <div class="section-header">

                <div>

                    <span>
                        CURATED FOR YOU
                    </span>

                    <h2>
                        Made for your mood.
                    </h2>

                </div>

                <a href="#">
                    View all →
                </a>

            </div>



            <div class="music-grid">


                <div class="music-card">

                    <div class="music-cover cover-purple">

                        <div class="cover-circle">
                            ✦
                        </div>

                        <button class="play-card">
                            ▶
                        </button>

                    </div>

                    <h3>
                        Late Night Vibes
                    </h3>

                    <p>
                        Chill · Dreamy · Lo-fi
                    </p>

                </div>



                <div class="music-card">

                    <div class="music-cover cover-blue">

                        <div class="cover-circle">
                            ◒
                        </div>

                        <button class="play-card">
                            ▶
                        </button>

                    </div>

                    <h3>
                        Blue Hour
                    </h3>

                    <p>
                        Indie · Alternative · Soul
                    </p>

                </div>



                <div class="music-card">

                    <div class="music-cover cover-pink">

                        <div class="cover-circle">
                            ∞
                        </div>

                        <button class="play-card">
                            ▶
                        </button>

                    </div>

                    <h3>
                        Dream State
                    </h3>

                    <p>
                        Ambient · Pop · Electronic
                    </p>

                </div>



                <div class="music-card">

                    <div class="music-cover cover-lavender">

                        <div class="cover-circle">
                            ✺
                        </div>

                        <button class="play-card">
                            ▶
                        </button>

                    </div>

                    <h3>
                        Sunday Morning
                    </h3>

                    <p>
                        Acoustic · Easy · Pop
                    </p>

                </div>

            </div>

        </section>



        <!-- =========================
             GENRES
        ========================== -->

        <section class="genre-section" id="genres">

            <div class="genre-text">

                <span>
                    FIND YOUR SOUND
                </span>

                <h2>

                    One world.
                    <br>

                    <strong>
                        Endless sounds.
                    </strong>

                </h2>

                <p>

                    From acoustic melodies to energetic
                    electronic beats, discover music for
                    every mood.

                </p>

            </div>


            <div class="genres">

                <button class="genre active">
                    Pop
                </button>

                <button class="genre">
                    R&B
                </button>

                <button class="genre">
                    Indie
                </button>

                <button class="genre">
                    Lo-fi
                </button>

                <button class="genre">
                    Jazz
                </button>

                <button class="genre">
                    Hip-Hop
                </button>

                <button class="genre">
                    Rock
                </button>

                <button class="genre">
                    Electronic
                </button>

                <button class="genre">
                    Acoustic
                </button>

            </div>

        </section>



        <!-- =========================
             ARTISTS
        ========================== -->

        <section class="artists section" id="artists">

            <div class="section-header">

                <div>

                    <span>
                        MEET THE ARTISTS
                    </span>

                    <h2>
                        Sounds worth knowing.
                    </h2>

                </div>

            </div>


            <div class="artist-grid">

                <div class="artist-card">

                    <div class="artist-photo artist-one">
                        L
                    </div>

                    <h3>
                        Luna
                    </h3>

                    <p>
                        Indie Pop
                    </p>

                </div>


                <div class="artist-card">

                    <div class="artist-photo artist-two">
                        A
                    </div>

                    <h3>
                        Arlo
                    </h3>

                    <p>
                        Alternative
                    </p>

                </div>


                <div class="artist-card">

                    <div class="artist-photo artist-three">
                        N
                    </div>

                    <h3>
                        Naya
                    </h3>

                    <p>
                        R&B Soul
                    </p>

                </div>


                <div class="artist-card">

                    <div class="artist-photo artist-four">
                        K
                    </div>

                    <h3>
                        Kairo
                    </h3>

                    <p>
                        Electronic
                    </p>

                </div>

            </div>

        </section>



        <!-- =========================
             CTA
        ========================== -->

        <section class="cta">

            <div class="cta-glow"></div>

            <span>
                THE WORLD OF MUSIC
            </span>

            <h2>

                Your next favorite
                <br>

                <strong>
                    song is waiting.
                </strong>

            </h2>

            <p>
                Start exploring music that feels like you.
            </p>

            <a href="#home" class="button-primary">
                Explore WiMusica →
            </a>

        </section>

    </main>



    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <div class="footer-logo">

            <div class="logo-icon">
                W
            </div>

            Wi<span>Musica</span>

        </div>

        <p>
            © 2026 WiMusica. Made for music lovers.
        </p>

        <div class="socials">

            <a href="#">
                Instagram
            </a>

            <a href="#">
                TikTok
            </a>

            <a href="#">
                Contact
            </a>

        </div>

    </footer>



    <!-- JS -->

    <script src="js/script.js"></script>

</body>
</html>
