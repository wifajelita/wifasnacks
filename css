@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap');


/* =====================================
   VARIABLES
===================================== */

:root {

    --dark: #080718;
    --dark-purple: #11102b;

    --purple: #7757e8;
    --purple-light: #bcaeff;

    --lavender: #d4caff;

    --blue: #759bff;

    --pink: #c88cff;

    --white: #ffffff;

    --gray: #a6a2ba;

}


/* =====================================
   RESET
===================================== */

* {

    margin: 0;
    padding: 0;

    box-sizing: border-box;

}


html {

    scroll-behavior: smooth;

}


body {

    font-family: "DM Sans", sans-serif;

    background:
        radial-gradient(
            circle at 80% 10%,
            rgba(116, 87, 232, .16),
            transparent 30%
        ),

        radial-gradient(
            circle at 10% 50%,
            rgba(117, 155, 255, .10),
            transparent 30%
        ),

        var(--dark);

    color: white;

    overflow-x: hidden;

}


a {

    text-decoration: none;

    color: inherit;

}


button {

    font-family: inherit;

}


/* =====================================
   BACKGROUND GLOW
===================================== */

.background-glow {

    position: fixed;

    width: 450px;
    height: 450px;

    border-radius: 50%;

    filter: blur(120px);

    opacity: .15;

    z-index: -1;

    pointer-events: none;

}


.glow-purple {

    background: #865dff;

    top: -250px;
    left: -150px;

}


.glow-blue {

    background: #568aff;

    right: -250px;
    top: 40%;

}


/* =====================================
   NAVBAR
===================================== */

.navbar {

    width: min(1180px, calc(100% - 50px));

    height: 85px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

}


.logo {

    display: flex;

    align-items: center;

    gap: 10px;

    font-family: "Outfit";

    font-size: 21px;

    font-weight: 800;

}


.logo-text span {

    color: var(--purple-light);

}


.logo-icon {

    width: 37px;
    height: 37px;

    border-radius: 11px;

    display: grid;

    place-items: center;

    font-family: "Outfit";

    font-weight: 800;

    color: white;

    background:

        linear-gradient(
            135deg,
            #c9bcff,
            #7654e7
        );

    box-shadow:
        0 8px 30px
        rgba(119,87,232,.4);

}


.nav-menu {

    display: flex;

    gap: 35px;

    color: var(--gray);

    font-size: 14px;

}


.nav-menu a {

    transition: .25s;

}


.nav-menu a:hover {

    color: white;

}


.nav-right {

    display: flex;

    align-items: center;

    gap: 15px;

}


.search-button {

    border: none;

    background: transparent;

    color: white;

    cursor: pointer;

    font-size: 17px;

}


.login-button {

    padding: 10px 20px;

    border-radius: 100px;

    border: 1px solid
        rgba(255,255,255,.15);

    background:
        rgba(255,255,255,.05);

    color: white;

    cursor: pointer;

}


.menu-button {

    display: none;

    border: none;

    background: transparent;

    color: white;

    font-size: 23px;

}


/* =====================================
   HERO
===================================== */

.hero {

    width: min(1180px, calc(100% - 50px));

    min-height: 700px;

    margin: auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    align-items: center;

}


.hero-label {

    display: flex;

    align-items: center;

    gap: 10px;

    color: var(--lavender);

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

    margin-bottom: 20px;

}


.hero-label span {

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #a98dff;

    box-shadow:
        0 0 0 7px
        rgba(169,141,255,.1);

}


.hero h1 {

    font-family: "Outfit";

    font-size: clamp(55px, 7vw, 88px);

    line-height: .98;

    letter-spacing: -4px;

}


.hero h1 strong {

    font-weight: 700;

    background:

        linear-gradient(
            100deg,
            #d6ccff,
            #91b5ff,
            #a77dff
        );

    -webkit-background-clip: text;

    color: transparent;

}


.hero-content > p {

    max-width: 510px;

    margin: 30px 0;

    color: var(--gray);

    font-size: 16px;

    line-height: 1.8;

}


/* =====================================
   BUTTONS
===================================== */

.hero-buttons {

    display: flex;

    gap: 14px;

}


.button-primary {

    display: inline-flex;

    align-items: center;

    gap: 18px;

    padding: 15px 23px;

    border-radius: 100px;

    color: #17122d;

    font-weight: 700;

    font-size: 14px;

    background:

        linear-gradient(
            110deg,
            #c9bdff,
            #7858e8
        );

    box-shadow:

        0 15px 40px
        rgba(119,87,232,.3);

    transition: .3s;

}


.button-primary:hover {

    transform: translateY(-3px);

    box-shadow:

        0 20px 50px
        rgba(119,87,232,.45);

}


.button-secondary {

    padding: 14px 22px;

    border-radius: 100px;

    border: 1px solid
        rgba(255,255,255,.12);

    color: #ddd9eb;

    font-size: 14px;

    transition: .3s;

}


.button-secondary:hover {

    background:
        rgba(255,255,255,.06);

}


/* =====================================
   STATS
===================================== */

.stats {

    display: flex;

    align-items: center;

    gap: 20px;

    margin-top: 55px;

}


.stats strong {

    display: block;

    font-family: "Outfit";

    font-size: 20px;

}


.stats span {

    display: block;

    margin-top: 3px;

    color: var(--gray);

    font-size: 11px;

}


.divider {

    width: 1px;

    height: 28px;

    background:
        rgba(255,255,255,.15);

}


/* =====================================
   HERO ART
===================================== */

.hero-art {

    height: 550px;

    position: relative;

    display: grid;

    place-items: center;

}


.big-glow {

    position: absolute;

    width: 330px;
    height: 330px;

    border-radius: 50%;

    background:

        linear-gradient(
            135deg,
            #835fff,
            #5c91ff
        );

    filter: blur(90px);

    opacity: .25;

}


.album {

    position: absolute;

    width: 285px;
    height: 285px;

    left: 60px;

    border-radius: 22px;

    overflow: hidden;

    background:

        linear-gradient(
            145deg,
            #c5b5ff,
            #657fe2 55%,
            #211d54
        );

    box-shadow:

        0 35px 70px
        rgba(0,0,0,.5);

    transform: rotate(-5deg);

}


.album-sun {

    position: absolute;

    width: 105px;
    height: 105px;

    border-radius: 50%;

    right: 35px;
    top: 30px;

    background:

        linear-gradient(
            135deg,
            #fff0c4,
            #bca8ff
        );

    box-shadow:

        0 0 50px
        rgba(255,235,190,.35);

}


.mountain {

    position: absolute;

    bottom: -20px;

    width: 0;
    height: 0;

    border-left: 150px solid transparent;

    border-right: 150px solid transparent;

    border-bottom: 220px solid #292554;

}


.mountain-one {

    left: -50px;

    opacity: .6;

    border-bottom-color:
        #4c58a2;

}


.mountain-two {

    right: -70px;

    border-bottom-color:
        #171532;

}


.album-title {

    position: absolute;

    bottom: 20px;
    left: 25px;

    font-family: "Outfit";

    font-size: 55px;

    font-weight: 800;

    color:
        rgba(255,255,255,.6);

}


/* =====================================
   VINYL
===================================== */

.vinyl {

    position: absolute;

    width: 260px;
    height: 260px;

    right: 40px;

    border-radius: 50%;

    background:

        repeating-radial-gradient(
            circle,
            #090909 0 2px,
            #181818 3px 4px
        );

    box-shadow:

        20px 25px 45px
        rgba(0,0,0,.55);

    animation:
        spin 15s linear infinite;

}


@keyframes spin {

    from {
        transform: rotate(0);
    }

    to {
        transform: rotate(360deg);
    }

}


.vinyl-center {

    position: absolute;

    width: 47px;
    height: 47px;

    left: calc(50% - 23px);
    top: calc(50% - 23px);

    border-radius: 50%;

    background:

        linear-gradient(
            135deg,
            #bbaaff,
            #674ddd
        );

    border: 5px solid #15141c;

}


/* =====================================
   NOW PLAYING
===================================== */

.now-playing {

    position: absolute;

    bottom: 40px;
    left: 0;

    width: 300px;

    padding: 13px;

    border-radius: 17px;

    display: flex;

    align-items: center;

    gap: 12px;

    background:
        rgba(30,27,57,.75);

    border:
        1px solid
        rgba(255,255,255,.13);

    backdrop-filter:
        blur(20px);

}


.song-image {

    width: 47px;
    height: 47px;

    border-radius: 11px;

    background:

        linear-gradient(
            135deg,
            #cbbcff,
            #607ce2
        );

}


.song-info {

    flex: 1;

}


.song-info small {

    display: block;

    font-size: 8px;

    letter-spacing: 1px;

    color: #8f8aa5;

}


.song-info strong {

    display: block;

    font-size: 12px;

    margin: 4px 0;

}


.song-info span {

    font-size: 9px;

    color: #8f8aa5;

}


.now-playing button {

    width: 34px;
    height: 34px;

    border: none;

    border-radius: 50%;

    background: white;

    color: #17132e;

    cursor: pointer;

}


.floating-note {

    position: absolute;

    width: 45px;
    height: 45px;

    display: grid;

    place-items: center;

    border-radius: 14px;

    background:
        rgba(255,255,255,.07);

    border:
        1px solid
        rgba(255,255,255,.1);

    color: var(--lavender);

    font-size: 21px;

}


.note-one {

    top: 70px;
    right: 40px;

    transform: rotate(10deg);

}


.note-two {

    bottom: 120px;
    right: 10px;

    color: var(--blue);

    transform: rotate(-10deg);

}


/* =====================================
   SECTIONS
===================================== */

.section {

    width: min(1180px, calc(100% - 50px));

    margin: auto;

    padding: 100px 0;

}


.section-header {

    display: flex;

    justify-content: space-between;

    align-items: end;

    margin-bottom: 35px;

}


.section-header span,
.genre-text > span,
.cta > span {

    color: var(--lavender);

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

}


.section-header h2,
.genre-text h2,
.cta h2 {

    font-family: "Outfit";

    font-size: clamp(36px, 5vw, 52px);

    line-height: 1;

    letter-spacing: -2px;

    margin-top: 12px;

}


.section-header > a {

    color: var(--lavender);

    font-size: 13px;

}


/* =====================================
   MUSIC CARDS
===================================== */

.music-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;

}


.music-cover {

    height: 240px;

    border-radius: 20px;

    position: relative;

    overflow: hidden;

    display: grid;

    place-items: center;

}


.cover-purple {

    background:
        linear-gradient(
            135deg,
            #b79cff,
            #704dde,
            #332067
        );

}


.cover-blue {

    background:
        linear-gradient(
            135deg,
            #9abaff,
            #5475df,
            #26356f
        );

}


.cover-pink {

    background:
        linear-gradient(
            135deg,
            #e1aaff,
            #9a62df,
            #48206f
        );

}


.cover-lavender {

    background:
        linear-gradient(
            135deg,
            #e5ddff,
            #a88de9,
            #6550b9
        );

}


.music-cover::before {

    content: "";

    position: absolute;

    width: 170px;
    height: 170px;

    border-radius: 50%;

    border:
        1px solid
        rgba(255,255,255,.35);

    box-shadow:

        0 0 0 30px
        rgba(255,255,255,.05),

        0 0 0 60px
        rgba(255,255,255,.035);

}


.cover-circle {

    font-size: 60px;

    position: relative;

    color:
        rgba(255,255,255,.7);

}


.play-card {

    position: absolute;

    right: 15px;
    bottom: 15px;

    width: 43px;
    height: 43px;

    border: none;

    border-radius: 50%;

    background: white;

    color: #17132e;

    cursor: pointer;

    opacity: 0;

    transition: .3s;

}


.music-card:hover
.play-card {

    opacity: 1;

}


.music-card h3 {

    margin-top: 16px;

    font-size: 15px;

}


.music-card p {

    margin-top: 5px;

    font-size: 11px;

    color: var(--gray);

}


/* =====================================
   GENRES
===================================== */

.genre-section {

    width: min(1180px, calc(100% - 50px));

    margin: 60px auto;

    padding: 85px;

    border-radius: 32px;

    border:
        1px solid
        rgba(255,255,255,.1);

    background:

        radial-gradient(
            circle at 80% 20%,
            rgba(121,88,236,.25),
            transparent 35%
        ),

        linear-gradient(
            135deg,
            rgba(255,255,255,.06),
            rgba(255,255,255,.015)
        );

    display: grid;

    grid-template-columns:
        .8fr 1.2fr;

    gap: 60px;

    align-items: center;

}


.genre-text h2 strong {

    background:

        linear-gradient(
            100deg,
            #cbbdff,
            #82aaff
        );

    -webkit-background-clip: text;

    color: transparent;

}


.genre-text p {

    max-width: 430px;

    color: var(--gray);

    line-height: 1.8;

    font-size: 14px;

    margin-top: 25px;

}


.genres {

    display: flex;

    flex-wrap: wrap;

    justify-content: center;

    gap: 13px;

}


.genre {

    padding: 14px 24px;

    border-radius: 100px;

    color: #ddd9eb;

    border:
        1px solid
        rgba(255,255,255,.12);

    background:
        rgba(255,255,255,.04);

    cursor: pointer;

    transition: .25s;

}


.genre:hover,
.genre.active {

    color: white;

    background:

        linear-gradient(
            120deg,
            rgba(191,174,255,.25),
            rgba(102,144,255,.2)
        );

    border-color:
        rgba(195,181,255,.4);

    transform:
        translateY(-3px);

}


/* =====================================
   ARTISTS
===================================== */

.artist-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;

}


.artist-card {

    text-align: center;

    padding: 30px 15px;

    border-radius: 20px;

    background:
        rgba(255,255,255,.025);

    border:
        1px solid
        rgba(255,255,255,.1);

    transition: .3s;

}


.artist-card:hover {

    transform:
        translateY(-5px);

    background:
        rgba(255,255,255,.06);

}


.artist-photo {

    width: 100px;
    height: 100px;

    border-radius: 50%;

    margin: auto;

    display: grid;

    place-items: center;

    font-family: "Outfit";

    font-size: 35px;

    font-weight: 700;

}


.artist-one {

    background:
        linear-gradient(
            135deg,
            #c9b8ff,
            #7655df
        );

}


.artist-two {

    background:
        linear-gradient(
            135deg,
            #9dbbff,
            #5274db
        );

}


.artist-three {

    background:
        linear-gradient(
            135deg,
            #e1c5ff,
            #9b65cf
        );

}


.artist-four {

    background:
        linear-gradient(
            135deg,
            #7972c3,
            #312d6e
        );

}


.artist-card h3 {

    margin-top: 17px;

    font-size: 15px;

}


.artist-card p {

    color: var(--gray);

    font-size: 11px;

    margin-top: 5px;

}


/* =====================================
   CTA
===================================== */

.cta {

    width: min(950px, calc(100% - 50px));

    margin: 80px auto 120px;

    padding: 100px 30px;

    text-align: center;

    border-radius: 32px;

    position: relative;

    overflow: hidden;

    background:

        radial-gradient(
            circle at center top,
            rgba(139,111,255,.25),
            transparent 45%
        ),

        #15122e;

    border:
        1px solid
        rgba(255,255,255,.1);

}


.cta-glow {

    position: absolute;

    width: 300px;
    height: 300px;

    border-radius: 50%;

    background: #795ce8;

    filter: blur(100px);

    opacity: .18;

    left: calc(50% - 150px);

    bottom: -230px;

}


.cta h2 {

    position: relative;

}


.cta h2 strong {

    background:

        linear-gradient(
            100deg,
            #d3c8ff,
            #82aaff
        );

    -webkit-background-clip: text;

    color: transparent;

}


.cta p {

    position: relative;

    color: var(--gray);

    margin: 20px 0 30px;

}


/* =====================================
   FOOTER
===================================== */

footer {

    width: min(1180px, calc(100% - 50px));

    margin: auto;

    padding: 30px 0 40px;

    border-top:
        1px solid
        rgba(255,255,255,.1);

    display: flex;

    justify-content: space-between;

    align-items: center;

    color: var(--gray);

    font-size: 11px;

}


.footer-logo {

    display: flex;

    align-items: center;

    gap: 9px;

    color: white;

    font-family: "Outfit";

    font-weight: 700;

}


.footer-logo span {

    color: var(--lavender);

}


.socials {

    display: flex;

    gap: 20px;

}


.socials a:hover {

    color: white;

}


/* =====================================
   MOBILE
===================================== */

@media (max-width: 900px) {

    .hero {

        grid-template-columns: 1fr;

        text-align: center;

        padding-top: 60px;

    }


    .hero-label,
    .hero-buttons,
    .stats {

        justify-content: center;

    }


    .hero-content > p {

        margin-left: auto;
        margin-right: auto;

    }


    .hero-art {

        margin-top: 30px;

    }


    .music-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }


    .genre-section {

        grid-template-columns: 1fr;

        padding: 60px 40px;

    }


    .artist-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }

}


@media (max-width: 650px) {

    .navbar,
    .hero,
    .section,
    footer {

        width:
            calc(100% - 30px);

    }


    .nav-menu {

        display: none;

    }


    .menu-button {

        display: block;

    }


    .login-button {

        display: none;

    }


    .hero h1 {

        font-size: 54px;

    }


    .hero-buttons {

        flex-direction: column;

    }


    .button-primary,
    .button-secondary {

        justify-content: center;

    }


    .hero-art {

        height: 420px;

    }


    .album {

        left: 15px;

        transform: scale(.8)
                   rotate(-5deg);

    }


    .vinyl {

        right: 0;

        transform: scale(.8);

    }


    .now-playing {

        left: 0;

        bottom: 10px;

        width: 280px;

    }


    .music-grid {

        grid-template-columns:
            1fr 1fr;

        gap: 12px;

    }


    .music-cover {

        height: 170px;

    }


    .play-card {

        opacity: 1;

    }


    .genre-section {

        width:
            calc(100% - 30px);

        padding:
            50px 25px;

    }


    .artist-grid {

        grid-template-columns:
            1fr 1fr;

    }


    footer {

        flex-direction: column;

        gap: 20px;

        text-align: center;

    }

}
